generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum EstadoMesa {
  libre
  ocupada

  @@map("estado_mesa")
}

enum EstadoPedido {
  pendiente
  confirmado
  en_preparacion
  listo
  entregado
  cancelado

  @@map("estado_pedido")
}

enum EstadoOrdenCocina {
  recibida
  en_preparacion
  lista

  @@map("estado_orden_cocina")
}

model Producto {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre      String
  descripcion String?
  precio      Decimal      @db.Decimal(12, 2)
  categoria   String?
  disponible  Boolean      @default(true)
  creadoEn    DateTime     @default(now()) @map("creado_en") @db.Timestamptz(3)
  items       ItemPedido[]

  @@map("producto")
}

model Mesa {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero    Int        @unique
  capacidad Int
  estado    EstadoMesa @default(libre)
  pedidos   Pedido[]

  @@map("mesa")
}

model Pedido {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mesaId       String       @map("mesa_id") @db.Uuid
  estado       EstadoPedido @default(pendiente)
  total        Decimal      @default(0) @db.Decimal(14, 2)
  creadoEn     DateTime     @default(now()) @map("creado_en") @db.Timestamptz(3)
  confirmadoEn DateTime?    @map("confirmado_en") @db.Timestamptz(3)
  mesa         Mesa         @relation(fields: [mesaId], references: [id], onDelete: Restrict)
  items        ItemPedido[]
  ordenCocina  OrdenCocina?
  eventos      Outbox[]

  @@index([mesaId])
  @@map("pedido")
}

model ItemPedido {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedidoId       String   @map("pedido_id") @db.Uuid
  productoId     String   @map("producto_id") @db.Uuid
  cantidad       Int
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(12, 2)
  pedido         Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@index([pedidoId])
  @@index([productoId])
  @@map("item_pedido")
}

model OrdenCocina {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedidoId      String             @unique @map("pedido_id") @db.Uuid
  estado        EstadoOrdenCocina   @default(recibida)
  creadoEn      DateTime           @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime           @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  pedido        Pedido             @relation(fields: [pedidoId], references: [id], onDelete: Restrict)

  @@map("orden_cocina")
}

model Outbox {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedidoId      String    @map("pedido_id") @db.Uuid
  eventType     String    @map("event_type")
  version       Int       @default(1)
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  correlationId String    @map("correlation_id") @db.Uuid
  payload       Json      @db.JsonB
  publicadoEn   DateTime? @map("publicado_en") @db.Timestamptz(3)
  pedido        Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Restrict)

  @@index([pedidoId])
  @@index([publicadoEn, occurredAt])
  @@map("outbox")
}
