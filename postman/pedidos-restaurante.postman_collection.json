{
  "info": {
    "name": "TPI IAEW — Pedidos en restaurante (E2)",
    "description": "Ejecutar en orden con el entorno privado seleccionado. 00 obtiene el token; 01–16 CRUD; 17–20 API key; 21–29 confirmación, efecto asíncrono del worker (espera acotada), cocina y entrega; 30–35 rechazos; 36–37 403 con cliente de solo lectura (se omiten si no está configurado). Requiere el seed (mesa 1 y productos 1 y 3).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "mesaId",
      "value": "b3f1a2e0-1111-4a2b-9c3d-000000000001"
    },
    {
      "key": "productoId",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    },
    {
      "key": "auth0Domain",
      "value": ""
    },
    {
      "key": "auth0Audience",
      "value": "https://api.pedidos-restaurante.local"
    },
    {
      "key": "auth0ClientId",
      "value": ""
    },
    {
      "key": "auth0ClientSecret",
      "value": ""
    },
    {
      "key": "auth0Scopes",
      "value": "read:pedidos write:pedidos confirm:pedidos admin:productos read:cocina write:cocina"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "productoSeedId",
      "value": "a1c9f0e0-2222-4a2b-9c3d-000000000001"
    },
    {
      "key": "productoSeedId2",
      "value": "a1c9f0e0-2222-4a2b-9c3d-000000000003"
    },
    {
      "key": "pedidoConfirmarId",
      "value": ""
    },
    {
      "key": "ordenId",
      "value": ""
    },
    {
      "key": "intentosOrden",
      "value": "0"
    },
    {
      "key": "productoNoDisponibleId",
      "value": ""
    },
    {
      "key": "readonlyToken",
      "value": ""
    },
    {
      "key": "auth0ReadonlyClientId",
      "value": ""
    },
    {
      "key": "auth0ReadonlyClientSecret",
      "value": ""
