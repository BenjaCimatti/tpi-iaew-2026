              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"Código ESTADO_INCOMPATIBLE\", () => pm.expect(pm.response.json().codigo).to.eql(\"ESTADO_INCOMPATIBLE\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "24 Esperar orden de cocina (worker)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/cocina/ordenes?estado=recibida",
        "header": []
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (Number(pm.collectionVariables.get(\"intentosOrden\") || 0) > 0) setTimeout(() => {}, 500);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Efecto asíncrono: el worker crea la orden tras consumir pedido.confirmado.",
              "// Espera acotada: hasta 10 intentos separados por 500 ms; luego falla.",
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const pedidoId = pm.collectionVariables.get(\"pedidoConfirmarId\");",
              "const orden = pm.response.code === 200 ? pm.response.json().find(o => o.pedidoId === pedidoId) : undefined;",
              "const intentos = Number(pm.collectionVariables.get(\"intentosOrden\") || 0) + 1;",
              "pm.collectionVariables.set(\"intentosOrden\", intentos);",
              "if (!orden && intentos < 10) {",
              "  pm.execution.setNextRequest(pm.info.requestName);",
              "} else {",
              "  pm.test(\"El worker creó la orden recibida\", () => { pm.expect(orden, \"Sin orden tras \" + intentos + \" intentos: revisar worker y RabbitMQ\").to.be.an(\"object\"); pm.expect(orden.estado).to.eql(\"recibida\"); pm.expect(orden.pedidoEstado).to.eql(\"confirmado\"); });",
              "  if (orden) pm.collectionVariables.set(\"ordenId\", orden.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "25 Rechazar salto de estado en cocina",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/cocina/ordenes/{{ordenId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado\": \"lista\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
