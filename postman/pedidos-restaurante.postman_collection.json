    {
      "name": "22 Confirmar pedido",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/pedidos/{{pedidoConfirmarId}}/confirmar",
        "header": []
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"intentosOrden\", 0);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Estado confirmado con fecha\", () => { pm.expect(body.estado).to.eql(\"confirmado\"); pm.expect(Number.isNaN(Date.parse(body.confirmadoEn))).to.eql(false); });",
              "pm.test(\"Total con precios capturados\", () => pm.expect(body.total).to.eql(body.items.reduce((s, i) => s + i.precioUnitario * i.cantidad, 0)));",
              "pm.test(\"Devuelve x-correlation-id\", () => pm.expect(pm.response.headers.get(\"x-correlation-id\")).to.match(/^[0-9a-f-]{36}$/));"
            ]
          }
        }
      ]
    },
