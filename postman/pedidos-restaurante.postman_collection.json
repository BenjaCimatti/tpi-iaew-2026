    {
      "name": "35 Rechazar token alterado",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/productos",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenAlterado}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Altera un carácter del medio de la firma del token vigente (el último solo lleva bits de relleno en base64url).",
              "const t = pm.collectionVariables.get(\"accessToken\") || \"\";",
              "const i = t.lastIndexOf(\".\") + 20;",
              "pm.variables.set(\"tokenAlterado\", t.slice(0, i) + (t[i] === \"A\" ? \"B\" : \"A\") + t.slice(i + 1));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "36 Obtener token de solo lectura (opcional)",
      "request": {
        "method": "POST",
        "url": "https://{{auth0Domain}}/oauth/token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"grant_type\": \"client_credentials\",\n  \"client_id\": \"{{auth0ReadonlyClientId}}\",\n  \"client_secret\": \"{{auth0ReadonlyClientSecret}}\",\n  \"audience\": \"{{auth0Audience}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"readonlyToken\");",
              "// Sin cliente de solo lectura configurado, se omiten 36 y 37 (fin de la colección).",
              "if (!pm.variables.get(\"auth0ReadonlyClientId\") || !pm.variables.get(\"auth0ReadonlyClientSecret\")) { pm.execution.setNextRequest(null); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Auth0 emite HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"readonlyToken\", pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
