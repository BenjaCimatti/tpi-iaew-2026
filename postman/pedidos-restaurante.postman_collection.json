        "body": {
          "mode": "raw",
          "raw": "{\n  \"mesaId\": \"{{mesaId}}\",\n  \"items\": [\n    {\n      \"productoId\": \"{{productoSeedId}}\",\n      \"cantidad\": 2\n    },\n    {\n      \"productoId\": \"{{productoSeedId2}}\",\n      \"cantidad\": 1\n    }\n  ]\n}",
