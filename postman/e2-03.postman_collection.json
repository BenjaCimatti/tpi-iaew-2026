        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Eliminar pedido pendiente",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/pedidos/{{pedidoId}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
