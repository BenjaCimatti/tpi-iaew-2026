{
  "info": {
    "name": "E2-03/E2-04 — CRUD y seguridad Auth0",
    "description": "Importar también auth0.local.postman_environment.json y seleccionar «TPI — Auth0 local (privado)» arriba a la derecha. La colección sola no contiene credenciales. Ejecutar 00 para obtener token, 01–16 para CRUD y 17–20 para API key. El recorrido completo requiere el seed y debe ejecutarse en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "mesaId",
      "value": "b3f1a2e0-1111-4a2b-9c3d-000000000001"
    },
    {
      "key": "productoId",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    },
    {
      "key": "auth0Domain",
      "value": ""
    },
    {
      "key": "auth0Audience",
      "value": "https://api.pedidos-restaurante.local"
    },
    {
      "key": "auth0ClientId",
      "value": ""
    },
    {
      "key": "auth0ClientSecret",
      "value": ""
    },
    {
      "key": "auth0Scopes",
      "value": "read:pedidos write:pedidos confirm:pedidos admin:productos read:cocina write:cocina"
    },
    {
      "key": "apiKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Obtener token Auth0",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "url": "https://{{auth0Domain}}/oauth/token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"grant_type\": \"client_credentials\",\n  \"client_id\": \"{{auth0ClientId}}\",\n  \"client_secret\": \"{{auth0ClientSecret}}\",\n  \"audience\": \"{{auth0Audience}}\",\n  \"scope\": \"{{auth0Scopes}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"accessToken\");",
              "const required = [\"auth0Domain\", \"auth0Audience\", \"auth0ClientId\", \"auth0ClientSecret\"];",
              "const missing = required.filter(key => !pm.variables.get(key));",
              "pm.test(\"Configuración Auth0 completa\", () => pm.expect(missing, \"Importá auth0.local.postman_environment.json y seleccioná TPI — Auth0 local (privado) arriba a la derecha. Faltan: \" + missing.join(\", \")).to.be.empty);",
              "if (missing.length) pm.execution.skipRequest();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Auth0 emite HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.test(\"Access token Bearer\", () => pm.expect(data.token_type === \"Bearer\" && typeof data.access_token === \"string\" && data.access_token.length > 0).to.eql(true));",
              "  if (data.token_type === \"Bearer\" && typeof data.access_token === \"string\" && data.access_token) pm.collectionVariables.set(\"accessToken\", data.access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "01 Salud pública",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Crear producto",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/productos",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Demo E2-03\",\n  \"precio\": 1250.5,\n  \"disponible\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"productoId\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"productoId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Listar productos",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/productos",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Producto persistido\", () => pm.expect((Array.isArray(pm.response.json()) && pm.response.json().some(p => p.id === pm.collectionVariables.get(\"productoId\")))).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Consultar producto",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/productos/{{productoId}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Crear pedido",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/pedidos",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mesaId\": \"{{mesaId}}\",\n  \"items\": [\n    {\n      \"productoId\": \"{{productoId}}\",\n      \"cantidad\": 2,\n      \"precioUnitario\": 1\n    }\n  ],\n  \"total\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"pedidoId\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"pedidoId\", pm.response.json().id);",
              "pm.test(\"Total calculado por servidor\", () => pm.expect(pm.response.json().total).to.eql(2501));",
              "pm.test(\"Pendiente sin confirmación\", () => { pm.expect(pm.response.json().estado).to.eql(\"pendiente\"); pm.expect(pm.response.json().confirmadoEn).to.eql(null); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Listar pedidos pendientes",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/pedidos?estado=pendiente",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Pedido persistido\", () => pm.expect((Array.isArray(pm.response.json()) && pm.response.json().some(p => p.id === pm.collectionVariables.get(\"pedidoId\")))).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Modificar precio del catálogo",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/productos/{{productoId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"precio\": 1400\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Modifica únicamente el precio del producto identificado en la URL. Conserva nombre, descripción, categoría y disponibilidad."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Solo cambia el precio\", () => { const producto = pm.response.json(); pm.expect(producto.precio).to.eql(1400); pm.expect(producto.nombre).to.eql(\"Demo E2-03\"); pm.expect(producto.disponible).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Editar pedido conservando precio",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/pedidos/{{pedidoId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mesaId\": \"{{mesaId}}\",\n  \"items\": [\n    {\n      \"productoId\": \"{{productoId}}\",\n      \"cantidad\": 3\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Precio histórico y total\", () => { pm.expect(pm.response.json().items[0].precioUnitario).to.eql(1250.5); pm.expect(pm.response.json().total).to.eql(3751.5); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Consultar pedido editado",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/pedidos/{{pedidoId}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Edición persistida\", () => pm.expect(pm.response.json().total).to.eql(3751.5));"
            ]
          }
        }
      ]
    },
    {
