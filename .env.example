# API
PORT=3000
WORKER_PORT=3001
LOG_LEVEL=info

# Base de datos
POSTGRES_USER=reemplazar_db_user
POSTGRES_PASSWORD=reemplazar_db_passwd
POSTGRES_DB=reemplazar_db
DATABASE_URL=postgresql://restaurante:restaurante@db:5432/restaurante

# Broker (RabbitMQ)
RABBITMQ_USER=reemplazar_rabbitmq_user
RABBITMQ_PASSWORD=reemplazar_rabbitmq_passwd
RABBITMQ_URL=amqp://restaurante:restaurante@broker:5672

# Auth0 externo (OAuth 2.0 / JWT)
AUTH0_DOMAIN=TU_DOMINIO.auth0.com
AUTH0_AUDIENCE=https://api.pedidos-restaurante.local
AUTH0_CLIENT_ID=reemplazar_con_client_id_m2m
AUTH0_CLIENT_SECRET=reemplazar_con_client_secret_m2m

# Cliente M2M de prueba autorizado únicamente con read:pedidos (para verificar 403)
AUTH0_READONLY_CLIENT_ID=reemplazar_con_client_id_solo_lectura
AUTH0_READONLY_CLIENT_SECRET=reemplazar_con_client_secret_solo_lectura

# Endpoint de comparación con API key
API_KEY=reemplazar_con_una_clave_de_ejemplo

# Grafana (http://localhost:3002). Lectura anónima habilitada para la demo.
GRAFANA_ADMIN_USER=reemplazar_admin_user
GRAFANA_ADMIN_PASSWORD=reemplazar_admin_passwd
