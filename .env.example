# API
PORT=3000

# Base de datos
POSTGRES_USER=restaurante
POSTGRES_PASSWORD=restaurante
POSTGRES_DB=restaurante
DATABASE_URL=postgresql://restaurante:restaurante@db:5432/restaurante

# Broker (RabbitMQ)
RABBITMQ_USER=restaurante
RABBITMQ_PASSWORD=restaurante
RABBITMQ_URL=amqp://restaurante:restaurante@broker:5672

# Auth0 (OAuth 2.0 / JWT)
AUTH0_DOMAIN=TU_DOMINIO.auth0.com
AUTH0_AUDIENCE=https://api.pedidos-restaurante.local
AUTH0_CLIENT_ID=reemplazar_con_client_id_m2m
AUTH0_CLIENT_SECRET=reemplazar_con_client_secret_m2m

# Endpoint de comparación con API key
API_KEY=reemplazar_con_una_clave_de_ejemplo
