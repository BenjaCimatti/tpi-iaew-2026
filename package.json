{
  "name": "pedidos-restaurante",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.22.1" },
  "scripts": {
    "start:api": "node --env-file-if-exists=.env src/api.js",
    "start:worker": "node --env-file-if-exists=.env src/worker.js",
    "test": "node --test test/*.test.js",
    "test:db": "node --env-file-if-exists=.env --test test/database.integration.js",
    "test:api": "node --env-file-if-exists=.env --test test/crud.integration.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "amqplib": "2.3.1",
    "express": "5.3.0",
    "express-oauth2-jwt-bearer": "1.11.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prisma": "7.10.1",
    "prom-client": "15.1.3",
    "ws": "8.22.2"
  }
}
